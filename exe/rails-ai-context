#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone mode: the RubyGems exe wrapper activates our gem and all transitive
# dependencies BEFORE this script runs. When inside a Rails app, Bundler.setup
# may need different versions of those deps (e.g., bigdecimal 4.1.0 activated here
# but Gemfile.lock wants 4.0.1). Clear non-default gem activations so Bundler can
# resolve cleanly. The $LOAD_PATH entries remain (Bundler.setup replaces them anyway).
#
# Skip this when running under `bundle exec` — Bundler has already resolved gems
# correctly, and clearing specs breaks gems that look up their own path at
# runtime out of Gem.loaded_specs (the MCP SDK does).
preboot_gem_specs = {}
preboot_framework_names = []
if defined?(Gem) && Gem.respond_to?(:loaded_specs) && !ENV["BUNDLE_BIN_PATH"]
  # Also strip the Rails-family gems' lib paths. Leaving them in $LOAD_PATH
  # lets the app's boot resolve framework files from the NEWEST installed
  # versions instead of the app's Gemfile.lock pins, producing a mixed
  # framework tree: wrong Rails.version in every generated fact and
  # "already initialized constant" double-load warnings. Every Rails app's
  # bundle provides these; in app-less modes a require re-activates them
  # fresh. The rest keep their paths until drop_conflicting_gem_activations!,
  # since thor and the gem's own files still load out of them in this window.
  rails_family = %w[
    rails railties activesupport activemodel activerecord actionpack
    actionview actionmailer activejob actioncable activestorage
    actionmailbox actiontext
  ].freeze
  Gem.loaded_specs.each_value do |spec|
    next if spec.default_gem?
    preboot_gem_specs[spec.name] = spec
    next unless rails_family.include?(spec.name)

    preboot_framework_names << spec.name
    spec.full_require_paths.each { |path| $LOAD_PATH.delete(path) }
  end
  Gem.loaded_specs.delete_if { |_, spec| !spec.default_gem? }
end

# Every gem the binstub activated, stashed while Gem.loaded_specs still names
# them: they keep their activated flag, so nothing else can re-add their paths.
PREBOOT_GEM_SPECS = preboot_gem_specs.freeze

# The subset whose paths came out of $LOAD_PATH right there. Only an app-less
# entry puts those back, so re-registering their specs would tell it not to.
PREBOOT_FRAMEWORK_NAMES = preboot_framework_names.freeze

# A C or POSIX locale names no encoding, so Ruby tags every path it reads -
# the working directory, $HOME, a glob - binary or US-ASCII, and the first
# one outside ASCII can be neither compared with nor joined to the gem's own
# UTF-8 strings. Rails makes UTF-8 the default when it boots; this binary
# reads paths and files before any boot, so it does the same first, for
# them and for the arguments it was given - when they are UTF-8. A folder
# or an argument in another encoding (Latin-1 bytes on disk) keeps the
# locale's tags, under which it is read byte by byte as before.
if Encoding.default_external == Encoding::US_ASCII
  utf8 = ->(text) { text.dup.force_encoding(Encoding::UTF_8).valid_encoding? }
  if (utf8.call(Dir.pwd) rescue false) && ARGV.all?(&utf8)
    verbose, $VERBOSE = $VERBOSE, nil
    Encoding.default_external = Encoding::UTF_8
    $VERBOSE = verbose
    ARGV.map! { |arg| arg.dup.force_encoding(Encoding::UTF_8) }
  end
end

# This file, wherever the gem is installed: what a child re-entering this very
# copy runs when no installed spec names it.
EXE_PATH = File.expand_path(__FILE__).freeze

# The command as typed, for the run a handoff to the app's bundled copy starts.
ORIGINAL_ARGV = ARGV.dup.freeze

# The environment this binary was started in, before an app's boot sets up
# the app's bundle in it.
STARTING_ENV = ENV.to_h.freeze

# After one of these tools' names `--environment` is its filter, never RAILS_ENV: this is
# decided before boot, when no tool schema can load. cli_smoke_spec holds it to the schemas.
ENVIRONMENT_PARAM_TOOLS = %w[env_config].freeze

require "shellwords"
require "thor"

# Top-level class to avoid conflict with RailsAiContext::CLI module (which contains ToolRunner).
# The library uses RailsAiContext::CLI as a module namespace; this exe needs a class for Thor.
class RailsAiContextCLI < Thor
    # Thor derives its namespace from the class name ("rails_ai_context_c_l_i")
    # and prints it as the root of the built-in `tree` command. Name it after
    # the binary so tree output matches what users actually type.
    namespace "rails-ai-context"

    # Without this, Thor exits 0 on an unrecognized command (and warns on
    # stderr that it will default to exit 1 in Thor 2.0). Scripts and AI
    # agents rely on a non-zero exit to detect a bad command.
    def self.exit_on_failure?
      true
    end

    # The words Thor is handed: switches behind the command name, and a
    # command's --help turned into `help <command>`.
    def self.normalize_argv(argv)
      help_request(reorder_switches(argv))
    end

    # Every switch this binary declares, global or per-command, and its type.
    def self.switch_types
      declared = class_options.values + commands.each_value.flat_map { |c| c.options.values }
      declared.each_with_object({}) do |option, table|
        ([ option.switch_name ] + Array(option.aliases)).each { |name| table[name] = option.type }
      end
    end

    HELP_FLAGS = %w[--help -h].freeze

    # `<command> --help` asks for that command's help, which Thor only gives
    # as `help <command>`: it read the flag as an argument the command does
    # not take, and `tool` and `preset` as the name to run. After a tool's
    # name the flag is that tool's (`tool schema --help` lists its params).
    def self.help_request(argv)
      command, *rest = argv
      return argv if command.nil? || command.start_with?("-") || command == "help"

      at = rest.index { |arg| HELP_FLAGS.include?(arg) } or return argv
      return argv if command == "tool" && named_tool?(rest.first(at))

      [ "help", command ]
    end

    # Whether these words after `tool` hold a tool name: a word that is
    # neither a switch nor the value a switch before it takes.
    def self.named_tool?(words)
      types = switch_types
      value_next = false
      words.each do |word|
        if value_next
          value_next = false
        elsif word.start_with?("-")
          type = types[word.split("=", 2).first]
          value_next = !word.include?("=") && !type.nil? && type != :boolean
        else
          return true
        end
      end
      false
    end

    # Thor names the command by its method in an argument error, and
    # `inspect` is defined as inspect_app; the name a user types is the
    # first word of the command's usage.
    def self.handle_argument_error(command, error, args, arity)
      super(command.dup.tap { |public_name| public_name.name = command.usage.split.first }, error, args, arity)
    end

    # Thor reads a leading switch as "no command given" and falls back to
    # `help`, which answers `rails-ai-context --app-path /x doctor` with usage
    # and exit 0. Move every switch this binary declares
    # (global or per-command) behind the command name; anything else is left
    # where it is, so `--help`, `--version` and an unknown switch keep their
    # own answers.
    def self.reorder_switches(argv)
      switches = switch_types
      globals = []
      rest = argv.dup
      while (token = rest.first) && token.start_with?("-")
        name, inline = token.split("=", 2)
        type = switches[name]
        break unless type

        globals << rest.shift
        globals << rest.shift if inline.nil? && type != :boolean && rest.first && !rest.first.start_with?("-")
      end

      return argv if globals.empty?
      # A switch this binary does not know still belongs to Thor, which
      # refuses it; the globals it follows have nothing to attach to.
      return rest if rest.first.to_s.start_with?("-")
      return argv if rest.empty?

      [ rest.first, *globals, *rest[1..] ]
    end

    # One answer for any command's failure; Thor's refusals and SystemExit pass through.
    no_commands do
      def invoke_command(command, *args)
        super
      rescue Thor::Error
        raise
      rescue StandardError, ScriptError => e
        $stderr.puts "Error: #{e.message}"
        Array(e.backtrace).first(15).each { |line| $stderr.puts "    #{line}" } if ENV["DEBUG"]
        exit 1
      end
    end

    # Let Thor pass unknown options through to ToolRunner for the tool command
    stop_on_unknown_option! :tool

    # Thor only recognizes bare subcommands by default; without this, `--version`
    # and `-v` fall through to "Could not find command" instead of the `version` task.
    map %w[--version -v] => :version

    class_option :app_path, type: :string,
      desc: "Path to the Rails app root (default: the app the current directory is in, or the one app below it)"
    class_option :environment, type: :string,
      desc: "RAILS_ENV to run under (default: the ambient RAILS_ENV or development)"

    desc "tool [NAME]", "Run an MCP tool. Use --list to see all."
    option :json, type: :boolean, default: false, desc: "Output as JSON envelope"
    option :list, type: :boolean, default: false, desc: "List available tools"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    def tool(name = nil, *args)
      # stop_on_unknown_option! passes post-name flags through into args;
      # honor --no-boot in either position, mirroring the --json handling.
      no_boot = options[:no_boot]
      no_boot = true if args.delete("--no-boot")

      if options[:list] || name.nil?
        print_tool_list(no_boot: no_boot)
        return
      end

      if args.include?("--help") || args.include?("-h")
        entry_boot.require_gem_without_app!
        tool_class = ::RailsAiContext::CLI::ToolRunner.new(name, []).tool_class
        puts ::RailsAiContext::CLI::ToolRunner.tool_help(tool_class)
        return
      end

      # `--json` is consumed as the Thor option only when it precedes the tool
      # name; `stop_on_unknown_option! :tool` passes it through into `args` when
      # it follows the name (the natural CLI position). Honor both placements by
      # also stripping it from args here, mirroring the --help handling above.
      json_mode = options[:json]
      json_mode = true if args.delete("--json")
      json_mode = true if args.delete("-j")

      # Value-taking class options land in args too. A tool that declares `environment`
      # keeps it: booting in the env it filters for fails where the app has no database.
      @app_path_override = extract_value_flag!(args, "--app-path")
      environment_flag = extract_value_flag!(args, "--environment")
      if environment_flag && ENVIRONMENT_PARAM_TOOLS.include?(name.to_s.delete_prefix("rails_").delete_prefix("get_"))
        args.push("--environment", environment_flag)
      else
        @environment_override = environment_flag
      end

      boot_rails!(command: "tool", allow_static: true, no_boot: no_boot)

      # A custom tool can declare `environment` too; the binary cannot see its
      # schema before boot, so it gets the value as RAILS_ENV and as its own.
      runner = ::RailsAiContext::CLI::ToolRunner.new(name, args, json_mode: json_mode,
                                                                environment: @environment_override)
      puts runner.run
      exit 1 if runner.error
    end

    # What Server#start takes; the gem's server cannot be loaded to ask it
    # before the app boots. streamable_http is http's other name there.
    SERVE_TRANSPORTS = %w[stdio http streamable_http].freeze

    desc "serve", "Start MCP server (stdio transport)"
    option :transport, type: :string, default: "stdio", desc: "Transport: stdio or http"
    option :port, type: :numeric, desc: "HTTP port (only for http transport; default: config http_port, else 6029)"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    def serve
      # Checked before the boot, which can take a minute, and in the words
      # the option is typed in rather than as Ruby symbols.
      unless SERVE_TRANSPORTS.include?(options[:transport])
        $stderr.puts "Error: Unknown transport '#{options[:transport]}'. Use stdio or http."
        exit 1
      end

      # A stdio client is waiting for the answer to `initialize` and gives up
      # after about 30 seconds; BootManager::STDIO_TIMEOUT says why the boot
      # gets less than that.
      if options[:transport] == "stdio"
        entry_boot
        ::RailsAiContext::BootManager.default_timeout = ::RailsAiContext::BootManager::STDIO_TIMEOUT
      end

      boot_rails!(command: "serve", allow_static: true)

      transport = options[:transport].to_sym
      # No Thor default: it would overwrite the config file's http_port.
      ::RailsAiContext.configuration.http_port = options[:port] if options[:port]

      ::RailsAiContext.start_mcp_server(transport: transport)
    end

    desc "context", "Generate AI context files"
    option :format, type: :string, default: nil, desc: "Format: claude, cursor, copilot, opencode, codex, json, all (default: from config)"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    def context
      # A repo you have just cloned is the case an agent most needs these files
      # for, and it is the case least likely to boot. Every command that reads
      # the app degrades the way `tool` does; doctor, whose job is diagnosing
      # the boot, is the one that still fails.
      boot_rails!(command: "context", allow_static: true)

      # Before the cleanup prompt and the introspection, both of which a
      # format nothing can write would waste.
      ::RailsAiContext::Serializers::ContextFileSerializer.validate_format!(options[:format]&.to_sym)

      if options[:format]
        cleanup_tools = options[:format] == "all" ? nil : [ options[:format].to_sym ]
      else
        cleanup_tools = ::RailsAiContext.configuration.ai_tools
      end
      ::RailsAiContext::LegacyCleanup.prompt_legacy_files(cleanup_tools, root: Dir.pwd)

      # An explicit --format names a file, so it is written either way. With
      # no format and an MCP-only install there is nothing to write, and the
      # rake surface says the same thing in the same words.
      if options[:format].nil? && !::RailsAiContext.configuration.context_files
        $stderr.puts "MCP-only install (config.context_files = false): no context files written."
        $stderr.puts "Run `rails-ai-context context --format claude` to write one anyway, " \
                     "or set config.context_files = true."
        return
      end

      # `rails ai:context` brings the selected tools' MCP configs up to date
      # on every run, in the form the install takes now. So does this, or an
      # app taken out of its bundle got context files naming the binary
      # beside configs that still start `bundle exec`.
      refresh_mcp_configs if options[:format].nil?

      $stderr.puts "Introspecting Rails app..."

      # An explicit --format overrides the recorded selection.
      result = ::RailsAiContext.generate_context(format: options[:format]&.to_sym)
      print_context_result(result)
    end

    desc "inspect", "Print introspection summary"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    def inspect_app
      boot_rails!(command: "inspect", allow_static: true)
      require "json"

      context = ::RailsAiContext.introspect
      puts JSON.pretty_generate(context)
    end

    # Thor registers commands under their Ruby method names, and this method
    # can't be called `inspect` (it would shadow Object#inspect). Re-key the
    # command so dispatch, `help inspect`, and `tree` all use the public name;
    # the command object still invokes inspect_app.
    commands["inspect"] = commands.delete("inspect_app")

    desc "watch", "Watch for changes and auto-regenerate context files"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    def watch
      reach_installed_gem("listen")
      boot_rails!(command: "watch", allow_static: true)
      ::RailsAiContext::Watcher.new.start
    end

    desc "doctor", "Run diagnostic checks and report AI readiness score"
    option :strict, type: :boolean, default: false, desc: "Exit 1 when any check fails (CI gate)"
    # Declared so the flag every other command takes is refused in words,
    # not with Thor's "was called with arguments"; hidden from the help.
    option :no_boot, type: :boolean, default: false, hide: true
    def doctor
      if options[:no_boot]
        $stderr.puts "Error: doctor diagnoses the app's boot, so it cannot skip it. Run it without --no-boot."
        exit 1
      end

      # Diagnosing a boot failure needs the app, so doctor never serves the
      # static tier; it does read a source-only tree, to name what is missing.
      boot_rails!(command: "doctor", allow_source_only: true,
                  boot_failure_hint: "  doctor needs a bootable app; fix the boot error above first.")
      result = ::RailsAiContext::Doctor.new.run
      # The report is the command's product - it belongs on stdout so
      # `doctor > report.txt` captures it. stderr stays for errors only.
      puts ::RailsAiContext::Doctor.report_lines(result)
      puts ""
      puts "AI Readiness Score: #{result[:score]}/100"

      failed = result[:checks].count { |c| c.status == :fail }
      if options[:strict] && failed > 0
        $stderr.puts "#{RailsAiContext::CountPhrase.call(failed, "check")} failed (--strict)"
        exit 1
      end
    end

    desc "init", "Set up rails-ai-context for standalone use (creates .rails-ai-context.yml, each AI tool's MCP config and its context files)"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    option :mcp_only, type: :boolean, default: false,
      desc: "Write the MCP config and nothing else: no CLAUDE.md, AGENTS.md, rules files or .ai-context.json"
    def init
      resolution = resolve_app_root!(workspace: true)
      return init_workspace(resolution.base, resolution.below) if resolution.workspace?

      refuse_no_app! unless entry_boot.app_present?(Dir.pwd, allow_source_only: true)

      require_install_files!
      program = ::RailsAiContext::Install::Program

      # --- Every question first, the previous selection read before them ---
      previous_tools = read_previous_ai_tools
      ai_tools = prompt_ai_tools(current: previous_tools)
      setup = prompt_setup
      tool_mode = setup.tool_mode
      context_files = setup.context_files
      dropped = program.ask_removed_tools(program_surface, previous: previous_tools, selected: ai_tools)
      unwired = tool_mode == :cli ? program.ask_mcp_removal(program_surface, root: Dir.pwd) : []
      # One-time v5.0.0 legacy UI-pattern files cleanup prompt
      ::RailsAiContext::LegacyCleanup.prompt_legacy_files(ai_tools, root: Dir.pwd) if context_files

      # --- Boot, then write ---
      # Nothing is written before the app's bundle is set up: the MCP configs
      # and the cleanup read and write JSON, and done first they loaded this
      # gem's newest json, which the app's pinned copy then loaded over. A
      # boot that fails falls back to the static tier rather than abandoning
      # the setup, since setup is exactly what you run on a repo you have
      # just cloned. An MCP-only setup needs nothing from the app, so it boots
      # nothing.
      boot_rails!(command: "init", allow_static: true) if context_files

      program.remove_tools(program_surface, dropped, selected: ai_tools, root: Dir.pwd)
      program.remove_mcp_entries(program_surface, unwired, root: Dir.pwd)
      record_selection(ai_tools, tool_mode, context_files)
      write_mcp_configs(ai_tools, tool_mode)
      add_to_gitignore(context_files)

      if context_files
        configure_answers!(ai_tools, tool_mode, context_files)
        $stderr.puts ""
        $stderr.puts "Generating AI context files..."
        print_context_result(::RailsAiContext.generate_context(format: ai_tools))
      else
        $stderr.puts ""
        $stderr.puts "MCP-only setup: no context files written."
      end

      # --- Instructions ---
      show_standalone_instructions(ai_tools, tool_mode, context_files)
    end

    desc "preset NAME", "Run a multi-tool preset (architecture, debugging, migration)"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    def preset(name = nil)
      require_relative "../lib/rails_ai_context/presets"

      outcome = ::RailsAiContext::Presets.dispatch(name, invocation: ->(k) { "rails-ai-context preset #{k}" }) do
        boot_rails!(command: "preset", allow_static: true)
      end
      exit 1 unless ::RailsAiContext::Presets.ok?(outcome)
    end

    desc "facts", "Print concise schema facts summary (tables, associations, dependencies)"
    option :no_boot, type: :boolean, default: false, desc: "Skip booting the app; serve static analysis only"
    def facts
      boot_rails!(command: "facts", allow_static: true)

      context = ::RailsAiContext.introspect
      puts ::RailsAiContext::FactsFormatter.render(
        context, full_json: "Run `rails-ai-context inspect` for the full introspection as JSON."
      )
    end

    desc "version", "Print version"
    def version
      require_relative "../lib/rails_ai_context/version"
      puts "rails-ai-context v#{RailsAiContext::VERSION}"
    end

    private

    # The install program's voice on this entry: everything on stderr, so
    # stdout stays a clean protocol channel.
    def program_surface
      @program_surface ||= ::RailsAiContext::Install::Surface.new(
        ->(text, level) { $stderr.puts(level == :warn ? "Warning: #{text}" : text) },
        lambda { |prompt|
          $stderr.print "#{prompt} "
          $stdin.gets&.strip
        },
        display_place
      )
    end

    # The root this run works in as the person who typed the command names
    # it, when they typed it outside that root (`init --app-path X` in X's
    # parent, a workspace named from elsewhere): the files it reports are
    # named from there, `X/.mcp.json`, since a bare `.mcp.json` reads as one
    # in the directory they are in. A typed --app-path is used as typed, the
    # way the commands it prints repeat it. Nil when they stand in the root
    # or below.
    def display_place
      result = @app_root_result or return nil
      root = result.root || result.base
      cwd = result.cwd
      return nil if root.nil? || cwd.nil? || cwd == root || cwd.start_with?("#{root}/")

      typed = @app_path_override || options[:app_path]
      result.explicit && typed ? typed.delete_suffix("/") : app_root.display(root, cwd)
    end

    def prompt_ai_tools(current: nil)
      ::RailsAiContext::Install::Program.select_ai_tools(program_surface, current: current)
    end

    # The answers, over the configuration the boot loaded from the files as
    # they stood before this run: the context files come out in the mode
    # just chosen, not the one the app had.
    def configure_answers!(ai_tools, tool_mode, context_files)
      config = ::RailsAiContext.configuration
      config.ai_tools = ai_tools
      config.tool_mode = tool_mode
      config.context_files = context_files
    end

    def prompt_setup
      if options[:mcp_only]
        return ::RailsAiContext::Install::Program::Setup.new(:mcp, false)
      end

      ::RailsAiContext::Install::Program.select_setup(program_surface)
    end

    def read_previous_ai_tools(root: Dir.pwd)
      ::RailsAiContext::Install::SelectionRecord.read(root: root)
    end

    def cleanup_removed_tools(previous, current, root: Dir.pwd, app_roots: [ root ])
      ::RailsAiContext::Install::Program.cleanup_removed_tools(
        program_surface, previous: previous, selected: current, root: root, app_roots: app_roots
      )
    end

    def add_to_gitignore(context_files = true, root: Dir.pwd)
      ::RailsAiContext::Install::Program.mark_gitignore(program_surface, root: root,
                                                       context_files: context_files)
    end

    def record_selection(ai_tools, tool_mode, context_files = true, root: Dir.pwd)
      result = ::RailsAiContext::Install::SelectionRecord.write(
        ai_tools, root: root,
        extra_yaml: { "tool_mode" => tool_mode.to_s, "context_files" => context_files }
      )
      record = ::RailsAiContext::Install::SelectionRecord
      # A workspace's apps are named from the workspace, where the run started.
      place = root == Dir.pwd ? program_surface.place : app_root.display(root, Dir.pwd)
      lines = { context_files: record.write_context_files(context_files, root: root),
                tool_mode: record.write_tool_mode(tool_mode, root: root) }
      conflicts = lines.filter_map { |key, status| record.conflict_message(key, status, place: place) }
      # The initializer is reported once, whichever of its three lines moved:
      # a mode switch that rewrote it said nothing.
      if lines.values.any? { |status| %i[updated inserted].include?(status) } && %i[unchanged absent].include?(result[:initializer])
        result = result.merge(initializer: :updated)
      end

      (record.messages(result, place: place) + conflicts).each do |level, text|
        $stderr.puts(level == :warn ? "Warning: #{text}" : text)
      end
    end

    # Only for a selection the app recorded: with none, `rails ai:context`
    # asks first, and this asks nothing, so it writes no config either.
    def refresh_mcp_configs
      config = ::RailsAiContext.configuration
      return unless config.tool_mode == :mcp && config.ai_tools&.any?

      tools = ::RailsAiContext::Install::Program.own_config_tools(config.ai_tools, root: Dir.pwd)
      write_mcp_configs(tools, :mcp) if tools.any?
    end

    # The install form is the app's own: under bundle exec the process's
    # bundle can be another app's (`init --app-path ../b` run from a).
    def write_mcp_configs(ai_tools, tool_mode, root: Dir.pwd, servers: nil)
      standalone = servers ? nil : ::RailsAiContext::InstallMode.standalone?(root: root)
      in_starting_env do
        ::RailsAiContext::Install::Program.write_mcp_configs(
          program_surface, tools: ai_tools, tool_mode: tool_mode, root: root, servers: servers, standalone: standalone
        )
      end
    end

    # Codex's config copies PATH and the gem variables out of this process
    # for the server Codex starts, so they are copied as the binary was
    # started. The app's boot sets up its bundle in this process, putting
    # GEM_HOME at the bundle's path and the bundle's bin directory first on
    # PATH, which no shell running the binary outside that bundle has.
    def in_starting_env
      now = ENV.to_h
      ENV.replace(STARTING_ENV)
      yield
    ensure
      ENV.replace(now) if now
    end

    # A folder of apps, set up as a whole. The AI tools are chosen once; each
    # app gets its own .rails-ai-context.yml and context files, since its
    # server reads them from its own root; and this folder's MCP configs get
    # one server per app, since a client reads them from the folder it opened
    # and from nowhere below it.
    def init_workspace(dir, roots)
      require_install_files!
      apps = ::RailsAiContext::Install::Workspace.apps(dir, roots)

      $stderr.puts "#{dir} is no Rails app; it holds #{apps.size == 1 ? 'one' : apps.size} below it. Setting up:"
      apps.each { |app| $stderr.puts "  #{app.path}/" }
      warn_ruby_mismatch(apps)

      # Before the prompts, as in an app: what each app recorded last time.
      previous = apps.flat_map { |app| read_previous_ai_tools(root: app.root) || [] }.uniq

      ai_tools = prompt_ai_tools(current: previous)
      setup = prompt_setup
      tool_mode = setup.tool_mode
      context_files = setup.context_files

      cleanup_removed_tools(previous, ai_tools, root: dir, app_roots: apps.map(&:root)) if previous.any?
      if tool_mode == :cli
        program = ::RailsAiContext::Install::Program
        program.remove_mcp_entries(program_surface, program.ask_mcp_removal(program_surface, root: dir), root: dir)
      end

      apps.each do |app|
        $stderr.puts ""
        $stderr.puts "#{app.path}/:"
        record_selection(ai_tools, tool_mode, context_files, root: app.root)
        add_to_gitignore(context_files, root: app.root)
      end

      # JSON and TOML hold UTF-8 alone, so an app whose folder is named in
      # another encoding cannot be named there: left out, the others' entries
      # are still written, where its name failed the whole file.
      configured, unnamed = apps.partition do |app|
        [ app.server.app_path, app.server.gemfile ].compact.all? { |path| path.dup.force_encoding(Encoding::UTF_8).valid_encoding? }
      end
      unnamed.each do |app|
        $stderr.puts ""
        $stderr.puts "Warning: #{app.path}/ is left out of this folder's MCP configs: its folder name is not UTF-8, which " \
                     "JSON and TOML require. Rename it, or run `rails-ai-context init` inside it for a config of its own."
      end

      $stderr.puts ""
      write_mcp_configs(ai_tools, tool_mode, root: dir, servers: configured.map(&:server))
      # This folder's own .gitignore, when it has one: the Codex config here
      # embeds this machine's PATH and GEM_HOME too.
      add_to_gitignore(false, root: dir)

      if context_files
        failed = apps.reject { |app| generate_app_context(app) }
      else
        failed = []
        $stderr.puts ""
        $stderr.puts "MCP-only setup: no context files written."
      end

      show_workspace_instructions(dir, apps, ai_tools, tool_mode, context_files, configured: configured)
      return if failed.empty?

      $stderr.puts "Error: no context files for #{failed.map { |app| "#{app.path}/" }.join(', ')} - see the output above. " \
                   "Retry with `#{app_root.command_line([ "rails-ai-context", "--app-path", app_root.option_path(app_root.display(failed.first.root, Dir.pwd)), "context" ])}`."
      exit 1
    end

    # A client opened here starts every app's server under the Ruby this
    # folder resolves to, and the context files below are generated the same
    # way; an app that declares another may not boot under it.
    def warn_ruby_mismatch(apps)
      running = RUBY_VERSION.split(".")
      apps.each do |app|
        declared = ::RailsAiContext::GemLock.for(app.root).ruby_version.to_s[/\A\d+(?:\.\d+){1,2}/] or next
        next if declared.split(".") == running.first(declared.count(".") + 1)

        $stderr.puts "Warning: #{app.path}/ declares Ruby #{declared}; this folder runs #{RUBY_VERSION}."
        $stderr.puts "  Its server here runs under #{RUBY_VERSION} too, so it may answer from source alone, and a " \
                     "bundle exec entry may not start. `rails-ai-context init` inside #{app.path}/ gives it a config of its own."
      end
    end

    # One process boots one app, so each app's context files come from a
    # child running the install that app's server runs: its bundle's copy of
    # the gem for an in-Gemfile app, this copy for a standalone one. The
    # child prompts for its own legacy files, so this process does not.
    def generate_app_context(app)
      $stderr.puts ""
      $stderr.puts "Generating AI context files for #{app.path}/..."

      flags = []
      flags << "--no-boot" if options[:no_boot]
      flags.push("--environment", options[:environment]) if options[:environment]
      if app.standalone
        env, command, bundled = own_binary
        command = [ *command, "context", *flags ]
      else
        env = { "BUNDLE_GEMFILE" => app.gemfile }
        command = [ "bundle", "exec", "rails-ai-context", "context", *flags ]
      end

      # Otherwise a parent run under bundle exec hands the child the
      # environment it was started with, the user's own Bundler settings
      # included, not its bundle.
      run = -> { system(env, *command, chdir: app.root) }
      original = !bundled && defined?(::Bundler) && ::Bundler.respond_to?(:with_original_env)
      ok = original ? ::Bundler.with_original_env(&run) : run.call
      $stderr.puts "Error: could not run `#{command.first}` - is it installed and on PATH?" if ok.nil?
      ok == true
    end

    # This copy of the gem, at this version, as a child runs it.
    #
    # Inside a bundle (a checkout's, or a folder's own Gemfile that lists the
    # gem) the child keeps this process's environment: its dependencies may
    # be installed nowhere else, as under a vendored BUNDLE_PATH. The bundle's
    # Gemfile is pinned, since the child starts in another directory.
    # Otherwise it is the installed spec, activated the way its RubyGems
    # wrapper does it (a wrapper found on PATH may load another version), or
    # this file with its own lib, as a checkout runs it.
    #
    # @return [Array(Hash, Array<String>, Boolean)] the child's environment,
    #   its command, and whether it keeps this process's bundle
    def own_binary
      from_lib = [ RbConfig.ruby, "-I", File.expand_path("../lib", __dir__), EXE_PATH ]
      if ENV["BUNDLE_BIN_PATH"] && defined?(::Bundler) && ::Bundler.respond_to?(:default_gemfile)
        return [ { "BUNDLE_GEMFILE" => ::Bundler.default_gemfile.to_s }, from_lib, true ]
      end

      spec = PREBOOT_GEM_SPECS["rails-ai-context"]
      return [ {}, from_lib, false ] unless spec

      [ {}, [ RbConfig.ruby, "-e", 'load Gem.activate_bin_path("rails-ai-context", "rails-ai-context", ARGV.shift)',
              "= #{spec.version}" ], false ]
    end

    def show_workspace_instructions(dir, apps, ai_tools, tool_mode, context_files, configured: apps)
      $stderr.puts ""
      $stderr.puts "=" * 50
      $stderr.puts " rails-ai-context initialized for #{apps.size == 1 ? '1 app' : "#{apps.size} apps"}"
      $stderr.puts "=" * 50
      $stderr.puts ""
      $stderr.puts "Your setup:"
      where = dir == Dir.pwd ? "here" : "in #{app_root.display(dir, Dir.pwd).delete_suffix('/')}/"
      ::RailsAiContext::Install::AiTool.all.each do |tool|
        next unless ai_tools.include?(tool.key)

        # The MCP config is this folder's, so it leaves the per-app list.
        files = context_files ? "#{tool.files_label(mcp: false)} in each app" : "no context files"
        files = "#{tool.mcp_config[:path]} #{where}; #{files}" if tool_mode == :mcp
        $stderr.puts "  #{tool.name.ljust(16)} -> #{files}"
      end
      if tool_mode == :mcp && configured.any?
        $stderr.puts ""
        $stderr.puts "MCP servers, one per app:"
        width = configured.map { |app| app.server_name.size }.max
        configured.each do |app|
          how = if app.standalone then ""
          elsif app.server.gemfile then " (bundle exec, BUNDLE_GEMFILE=#{app.server.gemfile})"
          else " (bundle exec)"
          end
          $stderr.puts "  #{app.server_name.ljust(width)} -> #{app.path}/#{how}"
        end
      end
      example = configured.first || apps.first
      first = app_root.command_line([ app_root.option_path(app_root.display(example.root, Dir.pwd)) ])
      $stderr.puts ""
      $stderr.puts "Commands, from here:"
      $stderr.puts "  rails-ai-context --app-path #{first} context    # Regenerate that app's context files" if context_files
      $stderr.puts "  rails-ai-context --app-path #{first} tool NAME  # Run a tool against it"
      $stderr.puts "  rails-ai-context --app-path #{first} doctor     # Check its AI readiness"
      $stderr.puts ""
      $stderr.puts "Config: .rails-ai-context.yml in each app (edit anytime, no restart needed)"
      $stderr.puts "Opening one app on its own? Run `rails-ai-context init` inside it."
      $stderr.puts ""
    end

    def show_standalone_instructions(ai_tools, tool_mode, context_files = true)
      $stderr.puts ""
      $stderr.puts "=" * 50
      $stderr.puts " rails-ai-context initialized!"
      $stderr.puts "=" * 50
      $stderr.puts ""
      $stderr.puts "Your setup:"
      ::RailsAiContext::Install::AiTool.all.each do |tool|
        next unless ai_tools.include?(tool.key)
        $stderr.puts "  #{tool.name.ljust(16)} -> #{context_files ? tool.files_label(mcp: tool_mode == :mcp) : 'MCP config only'}"
      end
      unless context_files
        $stderr.puts ""
        $stderr.puts "  Left alone on purpose: CLAUDE.md, AGENTS.md, the rules directories and .ai-context.json."
      end
      # Set up through --app-path from elsewhere, the commands name the app
      # the same way, or they would read the folder they are run in.
      result = @app_root_result
      typed = @app_path_override || options[:app_path]
      binary = "rails-ai-context"
      binary = app_root.command_line([ "rails-ai-context", "--app-path", app_root.option_path(typed) ]) if result&.explicit && typed && result.root != result.cwd
      $stderr.puts ""
      $stderr.puts "Commands:"
      $stderr.puts "  #{binary} context    # Regenerate context files" if context_files
      tools = served_tool_count
      $stderr.puts "  #{binary} tool NAME  # Run any of the #{RailsAiContext::CountPhrase.call(tools, "tool")}"
      if tool_mode == :mcp
        $stderr.puts "  #{binary} serve      # Start MCP server"
      end
      $stderr.puts "  #{binary} doctor     # Check AI readiness"
      $stderr.puts ""
      if tool_mode == :mcp
        $stderr.puts "MCP auto-discovery:"
        $stderr.puts "  Each AI tool gets its own config file — auto-detected on project open."
        $stderr.puts "  No manual config needed."
      else
        $stderr.puts "CLI tools:"
        $stderr.puts "  AI agents can run `rails-ai-context tool schema table=users` directly."
      end
      $stderr.puts ""
      config = display_place ? File.join(display_place, ".rails-ai-context.yml") : ".rails-ai-context.yml"
      $stderr.puts "Config: #{config} (edit anytime, no restart needed)"
      $stderr.puts ""
    end

    # What the server serves, skip_tools and custom_tools applied. An
    # MCP-only setup boots nothing, so the gem is loaded here for the count,
    # once every file is written. Without a boot the custom tools, app
    # classes, cannot load, so each entry counts as one.
    def served_tool_count
      return ::RailsAiContext::Server.exposed_tools.size if defined?(::RailsAiContext::Server)

      entry_boot.require_gem_without_app!
      ::RailsAiContext::Configuration.auto_load!(Dir.pwd)
      config = ::RailsAiContext.configuration
      ::RailsAiContext::Server.active_tools(config).size + config.custom_tools.size
    end

    def print_context_result(result)
      style = ::RailsAiContext::ContextFileReport.style(:plain)
      ::RailsAiContext::ContextFileReport.each_line(result, style, root: Dir.pwd, place: display_place) do |_bucket, text|
        $stderr.puts "  #{text}"
      end
    end

    # The tool list only needs tool names/descriptions/schemas - none of that
    # depends on a booted app (routes loaded, DB connected, etc.), so it
    # shouldn't require one. Boot normally when there's an app to boot (so
    # config-driven filtering like skip_tools/custom_tools still applies);
    # otherwise load the gem standalone and list from that. Only execution
    # (running a specific tool) genuinely needs a live app.
    def print_tool_list(no_boot: false)
      # No app is no refusal here: the app-less listing is the answer.
      resolve_app_root!(required: false)
      if entry_boot.app_present?(Dir.pwd, allow_source_only: true)
        outcome = enter_app(command: "tool", allow_static: true, no_boot: no_boot, allow_source_only: true)
        unless outcome.tier == :absent
          # The list still comes; a boot failure's whole report, meant for a
          # command that stops on it, would read as this command failing.
          if outcome.kind == :boot_failed
            $stderr.puts "[rails-ai-context] App boot failed (#{outcome.reason}); " \
                         "tools answer from source, and custom tools may be missing from this list."
          end
          puts ::RailsAiContext::CLI::ToolRunner.tool_list
          return
        end
      end

      begin
        entry_boot.require_gem_without_app!
        # Boot is what normally loads .rails-ai-context.yml, so without it the
        # listing took the gem's defaults and advertised tools the app has
        # configured off - which the very next call then refuses by name.
        ::RailsAiContext::Configuration.auto_load!(Dir.pwd)
        puts ::RailsAiContext::CLI::ToolRunner.tool_list
        puts ""
        puts "Run inside a Rails app to execute tools - static source analysis works even when the app can't boot (see --no-boot)."
      rescue LoadError, StandardError => e
        # A real app here is not a wrong directory: the listing failed because
        # the gem could not load, and saying otherwise sends the reader nowhere.
        if entry_boot.app_present?(Dir.pwd, allow_source_only: true)
          $stderr.puts "Error: the tool list needs this gem loaded, and it failed: #{e.message}"
        else
          $stderr.puts "  (gem also failed to load standalone: #{e.message})" if ENV["DEBUG"]
          refuse_no_app!
        end
        exit 1
      end
    end

    # Pull a value-taking flag (--flag VALUE or --flag=VALUE) out of the
    # pass-through args that stop_on_unknown_option! leaves after the tool
    # name. Returns the value, or nil when the flag isn't present.
    def extract_value_flag!(args, flag)
      if (idx = args.index(flag))
        args.delete_at(idx)
        return args.delete_at(idx)
      end
      if (pair = args.find { |a| a.start_with?("#{flag}=") })
        args.delete(pair)
        return pair.split("=", 2)[1]
      end
      nil
    end

    # `command` is the name the user types, which the refusal message quotes
    # back; every caller states it rather than reading Thor's command chain.
    # A command that needs more than the tier gives it says so here rather
    # than being recognised by name.
    def boot_rails!(command:, allow_static: false, no_boot: false, allow_source_only: allow_static,
                    boot_failure_hint: nil)
      outcome = enter_app(command: command, allow_static: allow_static, no_boot: no_boot,
                          allow_source_only: allow_source_only)
      outcome.messages.each { |line| $stderr.puts line }
      return unless outcome.tier == :absent

      $stderr.puts boot_failure_hint if boot_failure_hint && outcome.reason
      $stderr.puts "  #{@app_above_hint}" if @app_above_hint && !outcome.reason
      exit 1
    end

    # The app this command reads, booted or read from source as the command
    # allows. Prints nothing: the outcome carries the lines to say.
    def enter_app(command:, allow_static:, no_boot:, allow_source_only:)
      resolve_app_root!
      environment_opt = @environment_override || options[:environment]
      # Apps read RAILS_ENV in config/boot.rb, before anything the gem can
      # rescue, so the default is only reachable if it is set here.
      # The chain is Rails' own (`Rails.env`): RAILS_ENV, then RACK_ENV, then
      # development, with an empty value read as unset.
      ambient = [ environment_opt, ENV["RAILS_ENV"], ENV["RACK_ENV"] ]
      ENV["RAILS_ENV"] = ambient.find { |v| v && !v.empty? } || "development"

      # A command that can serve the static tier reads a source-only tree
      # instead of refusing it.
      entry_boot.call(root: Dir.pwd, allow_static: allow_static, no_boot: no_boot || options[:no_boot],
                      allow_source_only: allow_source_only, command: command, doctor: doctor_command)
    end

    # Which app this command reads, decided once and before anything reads
    # Dir.pwd, then made the process cwd: relative paths inside the app (log/,
    # tmp/, sqlite files, every install helper's root) assume it. Without
    # this, init wrote half its files where it was run and half into
    # --app-path, and `tool --list --app-path X` never booted X.
    #
    # `required: false` leaves the current directory in place when there is
    # no single app, for the one command that answers without one.
    # `workspace: true` is init's: a folder of apps is set up as a whole, so
    # that answer comes back with the process left where it stands.
    def resolve_app_root!(required: true, workspace: false)
      return @app_root_result if defined?(@app_root_result)

      cwd = Dir.pwd
      result = @app_root_result = app_root.resolve(cwd: cwd, app_path: @app_path_override || options[:app_path])
      return result if workspace && result.workspace?

      if result.explicit
        unless Dir.exist?(result.root)
          $stderr.puts "Error: No such directory: #{result.root}"
          hint = app_root.relative_path_hint(@app_path_override || options[:app_path], cwd)
          $stderr.puts "  #{hint}" if hint
          exit 1
        end
        if result.below.any? && required
          app_root.several_apps(result, cwd, ARGV).each { |line| $stderr.puts line }
          exit 1
        end
        @app_above_hint = app_root.app_above_hint(result.root, cwd) unless entry_boot.app_present?(result.root, allow_source_only: true)
      elsif result.root.nil?
        return result unless required && result.below.any?

        app_root.several_apps(result, cwd, ARGV).each { |line| $stderr.puts line }
        exit 1
      end

      # Bundler reads a relative BUNDLE_GEMFILE (a workspace entry names an
      # app's Gemfile that way) against the cwd. bundle exec hands its child an
      # absolute one, a direct run does not, so it is pinned before the cwd
      # moves, for this process's boot and every child it starts.
      gemfile = ENV["BUNDLE_GEMFILE"]
      ENV["BUNDLE_GEMFILE"] = File.expand_path(gemfile, cwd) if gemfile && !gemfile.empty?
      Dir.chdir(result.root) unless result.root == cwd
      # stderr only: stdout is the protocol channel for serve.
      $stderr.puts app_root.notice(result, cwd) if result.walked
      warning = app_root.bundle_warning(result.root, cwd)
      $stderr.puts warning if warning
      hand_off_to_bundle!(result.root, cwd)
      result
    end

    # The app's bundle carries its own copy of the gem: the command runs as
    # `bundle exec rails-ai-context` would run it, from where it was typed,
    # so one copy answers - the one the app's MCP configs start. When bundle
    # cannot be started this copy carries on.
    def hand_off_to_bundle!(root, cwd)
      handoff = app_root.bundled_handoff(root) or return
      bundle = Gem.bin_path("bundler", "bundle")
      $stderr.puts "[rails-ai-context] This app's bundle has rails-ai-context #{handoff.version}; " \
                   "running that copy, as bundle exec does."
      exec(handoff.env, RbConfig.ruby, bundle, "exec", "rails-ai-context", *ORIGINAL_ARGV, chdir: cwd)
    rescue Gem::Exception, SystemCallError
      nil
    end

    # The doctor run for this app as the command was typed: from where it was
    # typed, with the --app-path it named, under bundle exec when it ran so.
    def doctor_command
      result = @app_root_result
      typed = @app_path_override || options[:app_path]
      words = ENV["BUNDLE_BIN_PATH"] ? %w[bundle exec rails-ai-context] : %w[rails-ai-context]
      words += [ "--app-path", app_root.option_path(typed) ] if result&.explicit && typed && result.root != result.cwd
      app_root.command_line([ *words, "doctor" ])
    end

    def refuse_no_app!
      $stderr.puts "Error: No Rails app found in #{Dir.pwd}"
      $stderr.puts entry_boot::NO_APP_HINT
      $stderr.puts "  #{@app_above_hint}" if @app_above_hint
      exit 1
    end

    # Stdlib only, so it is safe to load before the app boots.
    def app_root
      entry_boot
      require_relative "../lib/rails_ai_context/cli/app_root"
      ::RailsAiContext::CLI::AppRoot
    end

    # A gem this binary uses when it is there - `listen`, for watch - is no
    # dependency of it, so the binstub never activated it, and the app's
    # bundle hides every gem the app does not lock: a standalone install
    # could not see a listen installed beside it. It is reached the way this
    # gem's own dependencies are, found among the installed gems before the
    # boot and put back behind the app's bundle after it, so a copy the app
    # locks still wins. Under bundle exec the bundle decides.
    def reach_installed_gem(name)
      return if ENV["BUNDLE_BIN_PATH"]

      found = [ Gem::Specification.find_by_name(name) ]
      found.each do |spec|
        spec.runtime_dependencies.each { |dep| found << dep.to_spec unless found.any? { |had| had.name == dep.name } }
      end
      # A default gem loads from Ruby's own directories already, and the
      # binstub's stash leaves them out the same way.
      found.reject!(&:default_gem?)
      found.each { |spec| spec.full_require_paths.each { |path| $LOAD_PATH << path unless $LOAD_PATH.include?(path) } }
      entry_boot.preboot_gem_specs = found.to_h { |spec| [ spec.name, spec ] }.merge(entry_boot.preboot_gem_specs)
    rescue Gem::LoadError
      nil
    end

    # Stdlib only, so it is safe to load before the app boots.
    def entry_boot
      @entry_boot ||= begin
        require_relative "../lib/rails_ai_context/cli/entry_boot"
        ::RailsAiContext::CLI::EntryBoot.preboot_gem_specs = PREBOOT_GEM_SPECS
        ::RailsAiContext::CLI::EntryBoot.preboot_framework_names = PREBOOT_FRAMEWORK_NAMES
        ::RailsAiContext::CLI::EntryBoot
      end
    end

    # What `init` needs before it boots the app, loaded file by file rather
    # than through the gem entry. The entry pulls in ActiveSupport and
    # Zeitwerk, and require_gem_without_app! splices the newest installed
    # framework paths in to get them - so booting the app afterwards leaves it
    # running one framework tree with another already loaded, and Rails' own
    # autoloader stops resolving implicit namespaces:
    #
    #   LoadError: cannot load such file -- <app>/app/channels/application_cable
    #
    # Every file here stands alone: no ActiveSupport, no Zeitwerk, no Rails.
    def require_install_files!
      %w[
        gem_lock install/ai_tool install/selection_record install/cleanup
        install/surface install/program mcp_config_generator install/workspace legacy_cleanup
      ].each { |file| require_relative "../lib/rails_ai_context/#{file}" }

      # Both are defined in the entry file, which is the thing that must not
      # load yet. With no Rails in the process log_warn only writes to stderr.
      unless ::RailsAiContext.respond_to?(:log_warn)
        ::RailsAiContext.define_singleton_method(:log_warn) { |message| $stderr.puts(message) }
      end

      return if ::RailsAiContext.respond_to?(:debug_fail)

      # Every rescue in the files above routes through this, so without it a
      # rescue that fires raises NoMethodError over the error it was catching.
      ::RailsAiContext.define_singleton_method(:debug_fail) do |error, fallback = nil, label:|
        $stderr.puts("[rails-ai-context] #{label} failed: #{error.message}") if ENV["DEBUG"]
        fallback
      end
    end
end

RailsAiContextCLI.start(RailsAiContextCLI.normalize_argv(ARGV))
