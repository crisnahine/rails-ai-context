# frozen_string_literal: true

# The canary. Runs the suite against prism's main branch so a removal there
# surfaces in this repo before it surfaces in a user's bundle. Allowed to fail.

source "https://rubygems.org"

gemspec path: ".."

gem "prism", github: "ruby/prism", branch: "main"

rails_version = ENV.fetch("RAILS_VERSION", "8.0")

group :development, :test do
  gem "railties", "~> #{rails_version}.0"
  gem "activerecord", "~> #{rails_version}.0"
  gem "actionmailer", "~> #{rails_version}.0"
  gem "puma"
  # Rails 7.0's sqlite3 adapter caps at sqlite3 ~> 1.4; the 2.x line is only
  # supported from Rails 7.1 on.
  if rails_version == "7.0"
    gem "sqlite3", "~> 1.4"
  else
    gem "sqlite3"
  end
  gem "logger"
end
