# frozen_string_literal: true

# The gemspec's mcp floor, pinned. The SDK's Tool::Response gained fields
# between 0.8 and 1.x, and the lockfile resolves the newest, so nothing else
# in CI would notice code that assumes the newer shape.

source "https://rubygems.org"

gemspec path: ".."

gem "mcp", "= 0.8.0"

rails_version = ENV.fetch("RAILS_VERSION", "8.0")

group :development, :test do
  gem "railties", "~> #{rails_version}.0"
  gem "activerecord", "~> #{rails_version}.0"
  gem "sqlite3"
  gem "logger"
end
