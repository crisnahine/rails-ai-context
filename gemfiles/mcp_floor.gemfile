# frozen_string_literal: true

# The gemspec's mcp floor, pinned. Trimmed to what the suite needs so a dev
# dependency cannot quietly resolve mcp upward and turn the floor claim into a
# test of whatever version happened to win.

source "https://rubygems.org"

gemspec path: ".."

gem "mcp", "= 0.13.0"

rails_version = ENV.fetch("RAILS_VERSION", "8.0")

group :development, :test do
  gem "railties", "~> #{rails_version}.0"
  gem "activerecord", "~> #{rails_version}.0"
  gem "actionmailer", "~> #{rails_version}.0"
  gem "puma"
  gem "sqlite3"
  gem "logger"
end
